{
  "langrev": "1",
  "version": "0.1.0",

  // The boomkat engine is compiled from source alongside our own code (the
  // native C3 binding links engine internals, so there is no prebuilt lib).
  // The engine is expected beside this project, in ../boomkat.
  "c-sources": [
    "../boomkat/vendor/libregexp/libregexp.c",
    "../boomkat/vendor/libunicode/libunicode.c",
    "../boomkat/src/re_wrapper.c",
    "../boomkat/src/unicode_wrapper.c",
    "../boomkat/vendor/dtoa/cutils.c",
    "../boomkat/vendor/dtoa/dtoa.c",
    "../boomkat/src/dtoa_wrapper.c",
    "../boomkat/src/date_math.c",
    "../boomkat/src/native_stack.c",
    "../boomkat/src/sysmem.c"
  ],
  // Homebrew's linked OpenSSL archives require macOS 26. Keep C3, the C
  // sources, and scripts/build_uws.sh on the same deployment target. The
  // bkr-linux target overrides the flags that only make sense on macOS.
  "macos-min-version": "26.0",
  "cflags": "-O2 -mmacosx-version-min=26.0",
  "c-include-dirs": [
    "../boomkat/vendor/dtoa",
    "../boomkat/vendor/libregexp",
    "../boomkat/vendor/libunicode",
    "../boomkat/src"
  ],

  "dependency-search-paths": [ "vendor" ],

  "targets": {
    "test-server": {
      "type": "executable",
      "sources": [
        "../boomkat/src",
        "src/**"
      ],
      "opt": "O3",
      "single-module": true,
      "fp-math": "relaxed",
      "debug-info": "none",
      "features": [ "THREADED_DISPATCH" ],
      "dependencies": [ "libwebsockets" ],
      "linked-libraries": [ "vendor/lws-src/build/lib/libwebsockets.a" ],
      "link-args": [ "-lssl", "-lcrypto" ]
    },

    "bkr-opprof": {
      "type": "executable",
      "sources": [
        "../boomkat/src",
        "runtime/**"
      ],
      "opt": "O3",
      "single-module": true,
      "fp-math": "relaxed",
      "debug-info": "none",
      "features": [ "ARGON2_FORCE_SEQUENTIAL", "CONSOLE", "OP_PROFILE" ],
      "linked-libraries": [ "vendor/libuws_shim.a" ],
      "link-args": [ "-lc++", "-L/opt/homebrew/opt/openssl@3/lib", "-weak-lssl", "-weak-lcrypto" ]
    },

    "bkr-opprof-th": {
      "type": "executable",
      "sources": [
        "../boomkat/src",
        "runtime/**"
      ],
      "opt": "O3",
      "single-module": true,
      "fp-math": "relaxed",
      "debug-info": "none",
      "features": [ "ARGON2_FORCE_SEQUENTIAL", "CONSOLE", "OP_PROFILE", "THREADED_DISPATCH" ],
      "linked-libraries": [ "vendor/libuws_shim.a" ],
      "link-args": [ "-lc++", "-L/opt/homebrew/opt/openssl@3/lib", "-weak-lssl", "-weak-lcrypto" ]
    },

    "bkr-linux": {
      "type": "executable",
      "sources": [
        "../boomkat/src",
        "runtime/**"
      ],
      "opt": "O3",
      "single-module": true,
      "fp-math": "relaxed",
      "debug-info": "none",
      "cflags-override": "-O2",
      "features": [ "ARGON2_FORCE_SEQUENTIAL", "THREADED_DISPATCH", "CONSOLE" ],
      "linked-libraries": [ "vendor/libuws_shim-linux.a", "stdc++", "ssl", "crypto" ],
      "link-args-override": [ "-Wl,--gc-sections" ]
    },

    "bkr": {
      "type": "executable",
      "sources": [
        "../boomkat/src",
        "runtime/**"
      ],
      "opt": "O3",
      "single-module": true,
      "fp-math": "relaxed",
      "debug-info": "none",
      "features": [ "ARGON2_FORCE_SEQUENTIAL", "THREADED_DISPATCH", "CONSOLE" ],
      "linked-libraries": [ "vendor/libuws_shim.a" ],
      "link-args": [ "-lc++", "-dead_strip", "-L/opt/homebrew/opt/openssl@3/lib", "-weak-lssl", "-weak-lcrypto" ]
    },

    "bkr-perf": {
      "type": "executable",
      "sources": [
        "../boomkat-perf/src",
        "runtime/**"
      ],
      "opt": "O3",
      "single-module": true,
      "fp-math": "relaxed",
      "debug-info": "none",
      "features": [ "ARGON2_FORCE_SEQUENTIAL", "THREADED_DISPATCH", "CONSOLE" ],
      "linked-libraries": [ "vendor/libuws_shim.a" ],
      "link-args": [ "-lc++", "-L/opt/homebrew/opt/openssl@3/lib", "-weak-lssl", "-weak-lcrypto" ]
    },

    "bkr-perf-asan": {
      "type": "executable",
      "sources": [
        "../boomkat-perf/src",
        "runtime/**"
      ],
      "opt": "O0",
      "sanitize": "address",
      "single-module": true,
      "fp-math": "relaxed",
      "debug-info": "full",
      "features": [ "ARGON2_FORCE_SEQUENTIAL", "THREADED_DISPATCH", "CONSOLE" ],
      "linked-libraries": [ "vendor/libuws_shim.a" ],
      "link-args": [ "-lc++", "-L/opt/homebrew/opt/openssl@3/lib", "-weak-lssl", "-weak-lcrypto" ]
    },

    "bkr-perf-prof": {
      "type": "executable",
      "sources": [
        "../boomkat-perf/src",
        "runtime/**"
      ],
      "opt": "O3",
      "single-module": true,
      "fp-math": "relaxed",
      "debug-info": "none",
      // Opcode counters run in switch dispatch; threading bypasses them.
      "features": [ "ARGON2_FORCE_SEQUENTIAL", "CONSOLE", "OP_PROFILE" ],
      "linked-libraries": [ "vendor/libuws_shim.a" ],
      "link-args": [ "-lc++", "-L/opt/homebrew/opt/openssl@3/lib", "-weak-lssl", "-weak-lcrypto" ]
    }
  }
}
