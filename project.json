{
  "langrev": "1",
  "version": "0.1.0",

  // The boomkat engine is compiled from source alongside our own code (the
  // native C3 binding links engine internals, so there is no prebuilt lib).
  // The engine is expected beside this project, in ../boomkat.
  "c-sources": [
    "../boomkat/vendor/libregexp/libregexp.c",
    "../boomkat/vendor/libunicode/libunicode.c",
    "../boomkat/src/re_wrapper.c",
    "../boomkat/src/unicode_wrapper.c",
    "../boomkat/vendor/dtoa/cutils.c",
    "../boomkat/vendor/dtoa/dtoa.c",
    "../boomkat/src/dtoa_wrapper.c",
    "../boomkat/src/date_math.c",
    "../boomkat/src/native_stack.c",
    "../boomkat/src/sysmem.c"
  ],
  // Homebrew's linked OpenSSL archives require macOS 26; scripts/build_uws.sh
  // reads this for the native shim. Per-platform linking (the C++ runtime,
  // OpenSSL, the shim archive) lives in vendor/uws.c3l/manifest.json, so
  // the same targets build on macOS and Linux.
  "macos-min-version": "26.0",
  "cflags": "-O2",
  "c-include-dirs": [
    "../boomkat/vendor/dtoa",
    "../boomkat/vendor/libregexp",
    "../boomkat/vendor/libunicode",
    "../boomkat/src"
  ],

  "dependency-search-paths": [ "vendor" ],

  "targets": {
    "bkr": {
      "type": "executable",
      "sources": [
        "../boomkat/src",
        "runtime/**"
      ],
      "opt": "O3",
      "single-module": true,
      "fp-math": "relaxed",
      "debug-info": "none",
      "features": [ "ARGON2_FORCE_SEQUENTIAL", "THREADED_DISPATCH", "CONSOLE" ],
      "dependencies": [ "uws" ]
    },

    "test-server": {
      "type": "executable",
      "sources": [
        "../boomkat/src",
        "src/**"
      ],
      "opt": "O3",
      "single-module": true,
      "fp-math": "relaxed",
      "debug-info": "none",
      "features": [ "THREADED_DISPATCH" ],
      "dependencies": [ "libwebsockets" ],
      "linked-libraries": [ "vendor/lws-src/build/lib/libwebsockets.a" ],
      "link-args": [ "-lssl", "-lcrypto" ]
    },

    "bkr-opprof": {
      "type": "executable",
      "sources": [
        "../boomkat/src",
        "runtime/**"
      ],
      "opt": "O3",
      "single-module": true,
      "fp-math": "relaxed",
      "debug-info": "none",
      "features": [ "ARGON2_FORCE_SEQUENTIAL", "CONSOLE", "OP_PROFILE" ],
      "dependencies": [ "uws" ]
    },

    "bkr-opprof-th": {
      "type": "executable",
      "sources": [
        "../boomkat/src",
        "runtime/**"
      ],
      "opt": "O3",
      "single-module": true,
      "fp-math": "relaxed",
      "debug-info": "none",
      "features": [ "ARGON2_FORCE_SEQUENTIAL", "CONSOLE", "OP_PROFILE", "THREADED_DISPATCH" ],
      "dependencies": [ "uws" ]
    },

    "bkr-perf": {
      "type": "executable",
      "sources": [
        "../boomkat-perf/src",
        "runtime/**"
      ],
      "opt": "O3",
      "single-module": true,
      "fp-math": "relaxed",
      "debug-info": "none",
      "features": [ "ARGON2_FORCE_SEQUENTIAL", "THREADED_DISPATCH", "CONSOLE" ],
      "dependencies": [ "uws" ]
    },

    "bkr-perf-asan": {
      "type": "executable",
      "sources": [
        "../boomkat-perf/src",
        "runtime/**"
      ],
      "opt": "O0",
      "sanitize": "address",
      "single-module": true,
      "fp-math": "relaxed",
      "debug-info": "full",
      "features": [ "ARGON2_FORCE_SEQUENTIAL", "THREADED_DISPATCH", "CONSOLE" ],
      "dependencies": [ "uws" ]
    },

    "bkr-perf-prof": {
      "type": "executable",
      "sources": [
        "../boomkat-perf/src",
        "runtime/**"
      ],
      "opt": "O3",
      "single-module": true,
      "fp-math": "relaxed",
      "debug-info": "none",
      // Opcode counters run in switch dispatch; threading bypasses them.
      "features": [ "ARGON2_FORCE_SEQUENTIAL", "CONSOLE", "OP_PROFILE" ],
      "dependencies": [ "uws" ]
    }
  }
}
