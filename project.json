{
  "langrev": "1",
  "version": "0.1.0",

  // The boomkat engine is compiled from source alongside our own code (the
  // native C3 binding links engine internals, so there is no prebuilt lib).
  // Paths are absolute because the engine lives outside this project.
  "c-sources": [
    "/Users/rtomasi/cousas/boomkat/libregexp/libregexp.c",
    "/Users/rtomasi/cousas/boomkat/libregexp/libunicode.c",
    "/Users/rtomasi/cousas/boomkat/libregexp/re_wrapper.c",
    "/Users/rtomasi/cousas/boomkat/libregexp/unicode_wrapper.c",
    "/Users/rtomasi/cousas/boomkat/vendor/dtoa/cutils.c",
    "/Users/rtomasi/cousas/boomkat/vendor/dtoa/dtoa.c",
    "/Users/rtomasi/cousas/boomkat/src/dtoa_wrapper.c",
    "/Users/rtomasi/cousas/boomkat/src/date_math.c",
    "/Users/rtomasi/cousas/boomkat/src/native_stack.c",
    "/Users/rtomasi/cousas/boomkat/src/sysmem.c"
  ],
  // Homebrew's linked OpenSSL archives require macOS 26. Keep C3, the C
  // sources, and scripts/build_uws.sh on the same deployment target.
  "macos-min-version": "26.0",
  "cflags": "-O2 -mmacosx-version-min=26.0",
  "c-include-dirs": [
    "/Users/rtomasi/cousas/boomkat/vendor/dtoa",
    "/Users/rtomasi/cousas/boomkat/libregexp"
  ],

  "dependency-search-paths": [ "vendor" ],

  "targets": {
    "test-server": {
      "type": "executable",
      "sources": [
        "/Users/rtomasi/cousas/boomkat/src",
        "src/**"
      ],
      "opt": "O3",
      "single-module": true,
      "fp-math": "relaxed",
      "debug-info": "none",
      "features": [ "THREADED_DISPATCH" ],
      "dependencies": [ "libwebsockets" ],
      "linked-libraries": [ "vendor/lws-src/build/lib/libwebsockets.a" ],
      "link-args": [ "-lssl", "-lcrypto" ]
    },

    "bkr-opprof": {
      "type": "executable",
      "sources": [
        "/Users/rtomasi/cousas/boomkat/src",
        "runtime/**"
      ],
      "opt": "O3",
      "single-module": true,
      "fp-math": "relaxed",
      "debug-info": "none",
      "features": [ "ARGON2_FORCE_SEQUENTIAL", "CONSOLE", "OP_PROFILE" ],
      "linked-libraries": [ "vendor/libuws_shim.a" ],
      "link-args": [ "-lc++", "/opt/homebrew/opt/openssl@3/lib/libssl.a", "/opt/homebrew/opt/openssl@3/lib/libcrypto.a" ]
    },

    "bkr-opprof-th": {
      "type": "executable",
      "sources": [
        "/Users/rtomasi/cousas/boomkat/src",
        "runtime/**"
      ],
      "opt": "O3",
      "single-module": true,
      "fp-math": "relaxed",
      "debug-info": "none",
      "features": [ "ARGON2_FORCE_SEQUENTIAL", "CONSOLE", "OP_PROFILE", "THREADED_DISPATCH" ],
      "linked-libraries": [ "vendor/libuws_shim.a" ],
      "link-args": [ "-lc++", "/opt/homebrew/opt/openssl@3/lib/libssl.a", "/opt/homebrew/opt/openssl@3/lib/libcrypto.a" ]
    },

    "bkr": {
      "type": "executable",
      "sources": [
        "/Users/rtomasi/cousas/boomkat/src",
        "runtime/**"
      ],
      "opt": "O3",
      "single-module": true,
      "fp-math": "relaxed",
      "debug-info": "none",
      "features": [ "ARGON2_FORCE_SEQUENTIAL", "THREADED_DISPATCH", "CONSOLE" ],
      "linked-libraries": [ "vendor/libuws_shim.a" ],
      "link-args": [ "-lc++", "/opt/homebrew/opt/openssl@3/lib/libssl.a", "/opt/homebrew/opt/openssl@3/lib/libcrypto.a" ]
    },

    "bkr-perf": {
      "type": "executable",
      "sources": [
        "/Users/rtomasi/cousas/boomkat-perf/src",
        "runtime/**"
      ],
      "opt": "O3",
      "single-module": true,
      "fp-math": "relaxed",
      "debug-info": "none",
      "features": [ "ARGON2_FORCE_SEQUENTIAL", "THREADED_DISPATCH", "CONSOLE" ],
      "linked-libraries": [ "vendor/libuws_shim.a" ],
      "link-args": [ "-lc++", "/opt/homebrew/opt/openssl@3/lib/libssl.a", "/opt/homebrew/opt/openssl@3/lib/libcrypto.a" ]
    },

    "bkr-perf-asan": {
      "type": "executable",
      "sources": [
        "/Users/rtomasi/cousas/boomkat-perf/src",
        "runtime/**"
      ],
      "opt": "O0",
      "sanitize": "address",
      "single-module": true,
      "fp-math": "relaxed",
      "debug-info": "full",
      "features": [ "ARGON2_FORCE_SEQUENTIAL", "THREADED_DISPATCH", "CONSOLE" ],
      "linked-libraries": [ "vendor/libuws_shim.a" ],
      "link-args": [ "-lc++", "/opt/homebrew/opt/openssl@3/lib/libssl.a", "/opt/homebrew/opt/openssl@3/lib/libcrypto.a" ]
    },

    "bkr-perf-prof": {
      "type": "executable",
      "sources": [
        "/Users/rtomasi/cousas/boomkat-perf/src",
        "runtime/**"
      ],
      "opt": "O3",
      "single-module": true,
      "fp-math": "relaxed",
      "debug-info": "none",
      // Opcode counters run in switch dispatch; threading bypasses them.
      "features": [ "ARGON2_FORCE_SEQUENTIAL", "CONSOLE", "OP_PROFILE" ],
      "linked-libraries": [ "vendor/libuws_shim.a" ],
      "link-args": [ "-lc++", "/opt/homebrew/opt/openssl@3/lib/libssl.a", "/opt/homebrew/opt/openssl@3/lib/libcrypto.a" ]
    }
  }
}
