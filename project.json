{
  "langrev": "1",
  "version": "0.1.0",

  // The boomkat engine is compiled from source alongside our own code (the
  // native C3 binding links engine internals, so there is no prebuilt lib).
  // Paths are absolute because the engine lives outside this project.
  "c-sources": [
    "/Users/rtomasi/Projects/boomkat/libregexp/libregexp.c",
    "/Users/rtomasi/Projects/boomkat/libregexp/libunicode.c",
    "/Users/rtomasi/Projects/boomkat/libregexp/re_wrapper.c",
    "/Users/rtomasi/Projects/boomkat/libregexp/unicode_wrapper.c",
    "/Users/rtomasi/Projects/boomkat/vendor/dtoa/cutils.c",
    "/Users/rtomasi/Projects/boomkat/vendor/dtoa/dtoa.c",
    "/Users/rtomasi/Projects/boomkat/src/dtoa_wrapper.c",
    "/Users/rtomasi/Projects/boomkat/src/date_math.c"
  ],
  "cflags": "-O2",
  "c-include-dirs": [
    "/Users/rtomasi/Projects/boomkat/vendor/dtoa",
    "/Users/rtomasi/Projects/boomkat/libregexp"
  ],

  "dependency-search-paths": [ "vendor" ],
  "dependencies": [ "libwebsockets" ],

  "targets": {
    "test-server": {
      "type": "executable",
      "sources": [
        "/Users/rtomasi/Projects/boomkat/src",
        "/Users/rtomasi/Projects/boomkat/bindings/c3/boomkat.c3",
        "src/**"
      ],
      "opt": "O3",
      "single-module": true,
      "fp-math": "relaxed",
      "debug-info": "none",
      "features": [ "THREADED_DISPATCH" ],
      "linked-libraries": [ "vendor/lws-src/build/lib/libwebsockets.a" ],
      "link-args": [ "-lssl", "-lcrypto" ]
    },

    // The uWebSockets build. vendor/libuws_shim.a is uSockets plus the C++
    // shim, built by scripts/build_uws.sh -- it is not in c-sources because
    // the shim needs a C++ compiler and c3c's c-sources drive a C one.
    "test-server-uws": {
      "type": "executable",
      "sources": [
        "/Users/rtomasi/Projects/boomkat/src",
        "/Users/rtomasi/Projects/boomkat/bindings/c3/boomkat.c3",
        "src-uws/**"
      ],
      "opt": "O3",
      "single-module": true,
      "fp-math": "relaxed",
      "debug-info": "none",
      "features": [ "THREADED_DISPATCH" ],
      "linked-libraries": [ "vendor/libuws_shim.a" ],
      "link-args": [ "-lc++" ]
    }
  }
}
