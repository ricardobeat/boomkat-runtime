diff --git a/runtime/http_layout.c3 b/runtime/http_layout.c3
new file mode 100644
--- /dev/null
+++ b/runtime/http_layout.c3
@@ -0,0 +1,115 @@
+module bkr;
+
+import boomkat::heap;
+import boomkat::hobject;
+import boomkat::hstring;
+import boomkat::types;
+
+struct ResponseLayout {
+    bool valid;
+    uint epoch;
+    uint shape;
+    uint proto_shape;
+    uint shape_generation;
+    uint proto_generation;
+    uint[5] indices;
+    bool[5] inherited;
+}
+
+ResponseLayout[4] g_response_layouts;
+uint g_response_layout_next;
+
+// Values and backing storage remain live; only immutable layout information
+// is cached. The recycle epoch protects both shape identities.
+fn bool response_values(HObject* response, TVal* values) {
+    heap::Heap* h  = g_rt.rt.heap;
+    HObject* proto = g_fast.response_proto;
+    if (response.get_class() != OBJECT || response.flags.exotic_proxyobj || proto.flags.exotic_proxyobj
+        || response.in_dict_mode(
+        h
+    ) || proto.in_dict_mode(h)) return false;
+    uint generation        = response.shape_generation(h);
+    uint proto_generation  = proto.shape_generation(h);
+    ResponseLayout* layout = null;
+    foreach (&entry : g_response_layouts) {
+        if (entry.valid && entry.epoch == h.shape_recycle_epoch && entry.shape == response.shape_id
+            && entry.proto_shape == proto.shape_id
+            && entry.shape_generation == generation
+            && entry.proto_generation == proto_generation) {
+            layout = entry;
+            break;
+        }
+    }
+    if (layout == null) {
+        ResponseLayout next;
+        HString*[5] keys = { g_fast.k_headers, g_fast.k_used, g_fast.k_status, g_fast.k_ct, g_fast.k_body };
+        foreach (i, key : keys) {
+            HObject* owner = response;
+            int index      = owner.find_prop_idx(key, h);
+            if (index < 0) {
+                owner = proto;
+                index = owner.find_prop_idx(key, h);
+                next.inherited[i] = true;
+            }
+            if (index < 0 || owner.get_prop_flags((uint)index, h).is_accessor) return false;
+            next.indices[i] = (uint)index;
+        }
+        next.valid = true;
+        next.epoch = h.shape_recycle_epoch;
+        next.shape = response.shape_id;
+        next.proto_shape = proto.shape_id;
+        next.shape_generation = generation;
+        next.proto_generation = proto_generation;
+        layout = &g_response_layouts[g_response_layout_next++ % g_response_layouts.len];
+        *layout = next;
+    }
+    PropValue* own       = response.prop_values();
+    PropValue* inherited = proto.prop_values();
+    for (uint i = 0; i < 5; i++) {
+        values[i] = (layout.inherited[i] ? inherited : own)[layout.indices[i]].get();
+    }
+    return true;
+}
+
+struct RequestLayout {
+    bool valid;
+    uint epoch;
+    uint shape;
+}
+
+RequestLayout[2] g_request_layouts;
+
+// A fresh request defines these own data properties in a fixed order. The
+// first request establishes the layout; later requests initialize its slots
+// through the engine's ownership and publication barriers.
+fn HObject*? request_object(heap::Heap* h, TVal* values, bool body) {
+    RequestLayout* layout = &g_request_layouts[body ? 1 : 0];
+    uint count            = body ? 5 : 4;
+    HObject* request;
+    if (layout.valid && layout.epoch == h.shape_recycle_epoch) {
+        request = h.alloc_object(OBJECT)!;
+        // Body consumption adds _used and can materialize _headers. Match
+        // ordinary property growth so those writes do not immediately grow.
+        if (body) {
+            request.prop_alloc = h.pool_alloc(8 * PropValue::size)!;
+            request.prop_capacity = 8;
+        }
+        h.init_object_shape(request, layout.shape)!;
+        h.set_prototype(request, g_fast.request_proto);
+        for (uint i = 0; i < count; i++) {
+            h.store_slot_ref(request, &request.prop_values()[i], &values[i]);
+        }
+    } else {
+        request = h.alloc_object(OBJECT)!;
+        h.set_prototype(request, g_fast.request_proto);
+        HString*[5] keys = { g_fast.k_method, g_fast.k_id, g_fast.k_url, g_fast.k_header_blob, g_fast.k_body };
+        for (uint i = 0; i < count; i++) {
+            if (!request.put_prop(keys[i], values[i], hobject::PROP_FLAGS_WEC, h)) return heap::HEAP_ALLOC_FAULT~;
+        }
+        if (!request.in_dict_mode(h)) {
+            request.get_shape(h).shared = true;
+            *layout = { true, h.shape_recycle_epoch, request.shape_id };
+        }
+    }
+    return request;
+}
