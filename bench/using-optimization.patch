+// The method is captured before binding initialization, just as in a list record.
+fn void builtin_scope_resource_method(BuiltinContext* ctx) {
+    TVal value = ctx.argc > 0 ? ctx.regs[ctx.base_reg] : types::make_undefined();
+    ctx.result_undefined();
+    if (value.is_null() || value.is_undefined()) return;
+    if (!value.is_object() || value.get_heapptr() == null) {
+        builtin_throw_no_result_change(ctx, ctx.heap.type_err_proto, "a using declaration requires an object");
+        return;
+    }
+    TVal method;
+    if (!disposable_lookup_method(ctx, value, false, &method)) return;
+    if (!is_callable_tval(method)) {
+        builtin_throw_no_result_change(ctx, ctx.heap.type_err_proto, "the dispose method is not a function");
+        return;
+    }
+    ctx.copy_result(method);
+}
+
+fn void builtin_scope_dispose_single(BuiltinContext* ctx) {
+    TVal value = ctx.regs[ctx.base_reg];
+    TVal method = ctx.regs[ctx.base_reg + 1];
+    TVal pending = ctx.regs[ctx.base_reg + 2];
+    TVal flag = ctx.regs[ctx.base_reg + 3];
+    bool threw = flag.is_boolean() && flag.get_boolean();
+    if (is_callable_tval(method)) {
+        disposable_call(ctx.heap, ctx.vm, method, value, DISPOSABLE_CALL_METHOD);
+        if (ctx.heap.has_error) disposable_fold_error(ctx.heap, ctx.vm, &pending, &threw);
+    }
+    if (threw) {
+        ctx.should_throw = true;
+        ctx.throw_value = pending;
+    }
+}
